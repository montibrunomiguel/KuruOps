# conectar com o role kuruops_app (ver db/README.md) -- nunca com o dono das tabelas
DATABASE_URL=postgres://kuruops_app:password@localhost:5432/kuruops?sslmode=disable

# Opcionais -- sem elas, o pool usa o default do pgx (o maior entre 4 e
# runtime.NumCPU() para MaxConns, 0 para MinConns). Vale configurar
# explicitamente ao rodar mais de uma replica de um binario (api/ingest/
# worker): cada replica dimensiona seu pool de forma independente, entao a
# soma de MaxConns de todas as replicas de todos os binarios nao pode passar
# do max_connections configurado no Postgres. Formula de partida: divida o
# max_connections do Postgres pelo numero de replicas deste binario,
# deixando folga para os outros dois binarios e para conexoes diretas/admin.
# DB_POOL_MAX_CONNS=10
# DB_POOL_MIN_CONNS=0

HTTP_ADDR=:8080

# "jwt" (padrao): exige JWT_PRIVATE_KEY_PATH/JWT_PUBLIC_KEY_PATH, autenticacao real via
#   login (local/LDAP/SAML).
# "dev": permite subir sem gerar chaves (uma keypair RSA efemera e criada em memoria a
#   cada start), mas a autenticacao continua real -- o token do login funciona
#   normalmente contra /api/v1. Use este modo pra rodar localmente sem gerar chaves.
# "dev-headers": alem da keypair efemera, TROCA a verificacao de JWT por confiar nos
#   headers X-Tenant-ID/X-User-ID/X-Role direto -- um token de /auth/.../login NAO
#   autentica nesse modo. So serve pra curlar /api/v1 sem passar por login.
# NUNCA usar "dev" ou "dev-headers" fora de uma maquina de desenvolvedor.
AUTH_MODE=dev

# Gerar com:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Obrigatorios fora de AUTH_MODE=dev/dev-headers.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

SHUTDOWN_TIMEOUT=15s

# Limite de tempo para qualquer requisicao /api/v1 (exceto /events/stream,
# que e SSE de longa duracao por natureza -- ver router.go). Sem isso, uma
# requisicao presa esperando uma conexao do pool saturado (ver
# DB_POOL_MAX_CONNS abaixo) ficaria bloqueada indefinidamente em vez de
# falhar de forma limpa.
HTTP_REQUEST_TIMEOUT=30s

# Diretorio onde imagens anexadas (comentarios/fechamento de alerta) sao
# gravadas e servidas de volta -- so cmd/api usa isso.
UPLOAD_DIR=/data/uploads

# Backend do secrets.Store usado para resolver chaves de LLM/MCP, senha de bind
# do LDAP e keypair SP do SAML -- ver internal/secrets/store.go.
# "env" (padrao): stub em memoria, nunca durave, so serve pra dev.
# "vault": HashiCorp Vault, engine KV v2 -- exige VAULT_ADDR/VAULT_TOKEN.
# "kms": AWS KMS (Encrypt/Decrypt direto, sem Secrets Manager) -- exige
#   KMS_REGION/KMS_ACCESS_KEY_ID/KMS_SECRET_ACCESS_KEY/KMS_KEY_ID.
SECRETS_BACKEND=env

VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret

KMS_REGION=
KMS_ACCESS_KEY_ID=
KMS_SECRET_ACCESS_KEY=
KMS_KEY_ID=

# "true" so, para um deploy genuinamente on-prem cujo receptor de webhook,
# servidor MCP ou endpoint de LLM self-hosted more legitimamente em rede
# privada (RFC1918/RFC4193) ou loopback. Por padrao, internal/httpguard
# recusa discar qualquer URL de saida configurada por admin (Destination de
# webhook de escalonamento, endpoint de servidor MCP, base_url de LLM) que
# resolva pra um endereco loopback/link-local/privado, fechando um pivo de
# SSRF de "pode editar Settings" pra "pode alcancar rede interna" (ex.: um
# endpoint de metadata de nuvem em 169.254.169.254). Deixe vazio/false fora
# desse cenario.
# Declared in docker-compose.yml and deploy/k8s/02-configmap.yaml, so
# setting it here actually reaches the containers.
# ALLOW_PRIVATE_NETWORK_TARGETS=true

# Endpoint OTLP/HTTP de um coletor de tracing (ex.: http://otel-collector:4318).
# Vazio (padrao) mantem o tracing totalmente inerte -- nenhum exporter, nenhuma
# goroutine extra, ver internal/telemetry.Setup. So configure isso se ja existir
# um coletor OTel rodando (este projeto nunca sobe um).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Cliente OAuth do app-level que o fluxo "Conectar sua conta Google" (Settings
# -> Storage Integration -> Google Drive) usa -- opcional, vazio desativa esse
# caminho e deixa a opcao de service account (colar JSON) intacta.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Credenciais do Slack App que Settings -> Conectores -> Slack usa -- opcional,
# vazio desativa o botao "Conectar ao Slack". Ver docs/SLACK_APP_SETUP.pt-BR.md
# para criar o app e obter esses valores. SLACK_SIGNING_SECRET ainda nao e
# usado por nada nesta versao (sem receptor de Events API ainda), mas o Slack
# fixa esse valor na criacao do app de qualquer forma.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
