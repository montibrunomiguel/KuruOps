# docker compose reads a repo-root .env automatically -- never commit a
# real one (see .env.example for the template).
/.env

# Go
backend/bin/
backend/jwt_private.pem
backend/jwt_public.pem
backend/.env
backend/coverage.out
backend/.dev-keys/

# Local pg_dump output from `task db:backup` -- never commit a real dump
backups/

# Node
frontend/node_modules/
frontend/dist/
frontend/coverage/

# Task (taskfile.dev) checksum cache -- local build-state tracking, not source
.task/

# Editors / OS
.DS_Store
Thumbs.db
