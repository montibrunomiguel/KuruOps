# Environment overrides for `docker compose up` (see docker-compose.yml).
# Copy this file to `.env` in the repo root and edit it -- docker compose
# picks up a repo-root `.env` automatically, no extra flag needed.
#
# Every value below has a working default baked into docker-compose.yml
# (so `docker compose up` with no `.env` at all still works out of the
# box), but those defaults are PUBLIC -- they're printed right here in this
# example file and in docker-compose.yml's own source. They are fine for a
# single developer's laptop. They are NOT fine for anything reachable by
# anyone else (a shared staging box, a demo environment, anything with a
# public IP) -- override every credential-shaped value below before that.
#
# This file covers docker-compose.yml's own variables only. For the
# backend Go binaries' full configuration surface (JWT keys, secrets
# backend selection, Vault/KMS, etc.) see backend/.env.example instead --
# most of those aren't compose variables at all, they're read directly by
# cmd/api/cmd/ingest/cmd/worker's own config.Load.

# --- Postgres (the `postgres` service -- the real app database) ---
# CREDENTIAL. Superuser for the main Postgres container. Changing
# POSTGRES_USER also requires updating every `docker compose exec postgres
# psql -U postgres ...` call in Taskfile.yml (db:up, db:test:up, db:backup,
# and friends) -- they don't read this variable, they hardcode "postgres".
POSTGRES_USER=postgres
# CREDENTIAL.
POSTGRES_PASSWORD=postgres

# --- Postgres (the `postgres-target` service -- disposable test-only DB) ---
# Only used by internal/dbmigrate's own integration test (see Taskfile.yml's
# backend:test:migration), reset from scratch on every run. Overriding these
# also requires updating Taskfile.yml's separately-hardcoded
# TEST_MIGRATION_TARGET_USER/PASSWORD.
POSTGRES_TARGET_USER=postgres
POSTGRES_TARGET_PASSWORD=postgres

# --- App-level database roles (least-privilege, RLS-scoped) ---
# CREDENTIAL. Role cmd/api and cmd/ingest connect as -- no table ownership,
# no BYPASSRLS, see db/init/argusops_app_role.sql and db/README.md for why
# that's what makes row-level security actually apply.
ARGUSOPS_APP_PASSWORD=argusops_app
# CREDENTIAL. Role cmd/worker connects as -- owns/refreshes the dashboard's
# materialized views, needs BYPASSRLS to see across all tenants. See
# db/init/argusops_worker_role.sql.
ARGUSOPS_WORKER_PASSWORD=argusops_worker

# CREDENTIAL. AES-256 key (base64) encrypting secrets.PersistentEnvStore's
# rows in Postgres (LLM/MCP API keys, LDAP bind password, SAML SP keypair,
# webhook signing secrets, ...). The default below is a REAL working key,
# not a placeholder -- generate your own with `openssl rand -base64 32`
# before using this anywhere other than a laptop.
SECRETS_ENCRYPTION_KEY=k83Yh5rQGCdVDMbUtJywr5J6ScE6++Bp4m936YZDecw=

# "dev": cmd/api generates and persists its own JWT keypair instead of
# requiring JWT_PRIVATE_KEY_PATH/JWT_PUBLIC_KEY_PATH -- convenient for local
# dev, but never appropriate outside a developer's own machine. See
# backend/cmd/api/main.go's loadOrGenerateJWTKeys.
AUTH_MODE=dev

# Per-account login rate limit (cmd/api, applied to /auth) and per-IP
# webhook rate limit (cmd/ingest, applied to /hooks) -- requests per minute.
LOGIN_RATE_LIMIT_PER_MINUTE=20
WEBHOOK_RATE_LIMIT_PER_MINUTE=60

# OTLP/HTTP endpoint of a distributed-tracing collector (e.g.
# http://otel-collector:4318). Empty (the default) keeps tracing fully
# inert -- no exporter, no extra goroutines -- see
# backend/internal/telemetry.Setup's doc comment. Only set this if a
# collector already exists somewhere reachable from these containers; this
# stack never bundles one.
OTEL_EXPORTER_OTLP_ENDPOINT=

# CREDENTIAL, optional. App-level Google OAuth client for Settings -> Storage
# Integration -> Google Drive's "Connect your Google account" flow. Both
# empty (the default) disables that path entirely -- the service-account
# alternative (paste a JSON key in the UI) is unaffected either way.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# CREDENTIAL, optional. Slack App credentials for Settings -> Conectores ->
# Slack's "Conectar ao Slack" flow. Empty disables that button. See
# docs/SLACK_APP_SETUP.md for how to create the Slack App and obtain these.
# SLACK_SIGNING_SECRET isn't used by anything yet (no inbound Slack Events
# receiver exists in this release) but the Slack App fixes this value at
# creation time regardless, so it's collected now rather than asking you to
# reopen that page later.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Not settable here: VAULT_DEV_ROOT_TOKEN_ID (the vault-dev tools-profile
# service's root token) is hardcoded in docker-compose.yml, not read from
# env -- left that way deliberately, since vault-dev runs with in-memory
# storage and is wiped on every restart (see its own comment in
# docker-compose.yml), so there's nothing durable there to rotate.
